variable "project_id_prefix" {
  type        = string
  description = "An optional prefix to prepend to each affiliate project ID to ensure global uniqueness"
  default     = ""
}

variable "location" {
  type        = string
  description = "The location for the Discovery Engine resources (e.g., global, us, eu)"
  default     = "global"
}

variable "company_domain" {
  type        = string
  description = "The primary domain name for the Google Workspace tenant (e.g., example.com)"
}

variable "workspace_customer_id" {
  type        = string
  description = "The Google Workspace Customer ID (e.g., C01234567)"
}

variable "workspace_admin_email" {
  type        = string
  description = "The email address of a Google Workspace Administrator to impersonate (required for Workspace provider)"
}

variable "affiliates" {
  type = map(object({
    name   = string
    region = string
  }))
  default = {
    rwg-double-bay  = { name = "Double Bay", region = "New South Wales" }
    rwg-toorak      = { name = "Toorak", region = "Victoria" }
    rwg-new-farm    = { name = "New Farm", region = "Queensland" }
    rwg-mosman-park = { name = "Mosman Park", region = "Western Australia" }
    rwg-unley-park  = { name = "Unley Park", region = "South Australia" }
    rwg-sandy-bay   = { name = "Sandy Bay", region = "Tasmania" }
    rwg-fannie-bay  = { name = "Fannie Bay", region = "Northern Territory" }
  }
}

variable "folder_id" {
  type        = string
  description = "The ID of the GCP Folder where the projects should be created (optional)"
  default     = null
}

variable "org_id" {
  type        = string
  description = "The ID of the GCP Organization where the projects should be created (optional, if not using a folder)"
  default     = null
}

variable "billing_account" {
  type        = string
  description = "The billing account ID to associate with the created projects"
}

variable "billing_project" {
  type        = string
  description = "The GCP project ID to use for API quota and billing overrides"
  default     = "affiliates-bootstrap"
}

variable "sa_email" {
  type        = string
  description = "The email address of the GCP service account generated by bootstrap.sh"
}



